FROM debian:latest

LABEL maintainer="Zegang.luo@qq.com"
LABEL version="0.0.1"
LABEL description="cppio release container image"

RUN apt update && \
  apt install -y openssl curl gdb linux-perf && \
  rm -rf /var/lib/apt/lists/* && \
  apt clean

COPY build/cppio/cppio_install_root/bin /cppio/bin
COPY build/cppio/cppio_install_root/lib /cppio/lib
COPY build/cppio/cppio_install_root/config /cppio/config

ENV PATH="$PATH:/cppio/bin"
ENV LD_LIBRARY_PATH="/cppio/lib:$LD_LIBRARY_PATH"
ENV CPPIO_ROOT="/cppio"
